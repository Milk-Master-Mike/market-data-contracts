{
  "$defs": {
    "EvidenceConflict": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect": {
          "minLength": 1,
          "title": "Effect",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "description",
        "evidence_ids",
        "effect"
      ],
      "title": "EvidenceConflict",
      "type": "object"
    },
    "ScoreComponent": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Contribution"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "name",
        "weight",
        "value",
        "contribution",
        "explanation"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "description": "Required provenance and quality metadata for a normalized fact.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "description": "Evidence quality from 0 to 1; never investment-performance probability.",
          "title": "Confidence"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "evidence_id": {
          "description": "Stable ID unique within a research run.",
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional short evidence excerpt; never a republished full article.",
          "title": "Excerpt"
        },
        "parser_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Parser Version",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "units": {
          "description": "Explicit units, such as shares, USD, ratio, or not_applicable.",
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_name",
        "source_url",
        "retrieved_at",
        "effective_date",
        "units",
        "parser_version",
        "confidence"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/Milk-Master-Mike/market-data-contracts/v0.1.0/schemas/HorizonAssessment.schema.json",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "calculation_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "title": "Calculation Version",
      "type": "string"
    },
    "calendar_months": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calendar Months"
    },
    "calendar_years": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calendar Years"
    },
    "company_id": {
      "minLength": 1,
      "title": "Company Id",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ScoreComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "evidence_strength_score": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
          "type": "string"
        }
      ],
      "title": "Evidence Strength Score"
    },
    "explanation": {
      "description": "Explains research evidence, never a buy/sell instruction or return forecast.",
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "freshness_score": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
          "type": "string"
        }
      ],
      "title": "Freshness Score"
    },
    "horizon_label": {
      "minLength": 1,
      "title": "Horizon Label",
      "type": "string"
    },
    "kind": {
      "const": "horizon_assessment",
      "default": "horizon_assessment",
      "title": "Kind",
      "type": "string"
    },
    "missing_inputs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "research_relevance_score": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
          "type": "string"
        }
      ],
      "title": "Research Relevance Score"
    },
    "trading_days": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trading Days"
    }
  },
  "required": [
    "assessment_id",
    "company_id",
    "horizon_label",
    "research_relevance_score",
    "evidence_strength_score",
    "freshness_score",
    "components",
    "calculation_version",
    "explanation",
    "evidence"
  ],
  "title": "HorizonAssessment",
  "type": "object",
  "x-contract-version": "0.1.0"
}
