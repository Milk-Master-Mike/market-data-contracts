{
  "$defs": {
    "FloatMeasure": {
      "enum": [
        "issuer_reported_public_float",
        "shares_outstanding",
        "tradable_free_float",
        "other"
      ],
      "title": "FloatMeasure",
      "type": "string"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "description": "Required provenance and quality metadata for a normalized fact.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "description": "Evidence quality from 0 to 1; never investment-performance probability.",
          "title": "Confidence"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "evidence_id": {
          "description": "Stable ID unique within a research run.",
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional short evidence excerpt; never a republished full article.",
          "title": "Excerpt"
        },
        "parser_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Parser Version",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "units": {
          "description": "Explicit units, such as shares, USD, ratio, or not_applicable.",
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_name",
        "source_url",
        "retrieved_at",
        "effective_date",
        "units",
        "parser_version",
        "confidence"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/Milk-Master-Mike/market-data-contracts/v0.1.0/schemas/FloatSnapshot.schema.json",
  "additionalProperties": false,
  "properties": {
    "as_of_date": {
      "format": "date",
      "title": "As Of Date",
      "type": "string"
    },
    "company_id": {
      "minLength": 1,
      "title": "Company Id",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "evidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "instrument_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrument Id"
    },
    "kind": {
      "const": "float_snapshot",
      "default": "float_snapshot",
      "title": "Kind",
      "type": "string"
    },
    "measure": {
      "$ref": "#/$defs/FloatMeasure"
    },
    "methodology": {
      "minLength": 1,
      "title": "Methodology",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "snapshot_id",
    "company_id",
    "measure",
    "value",
    "as_of_date",
    "methodology",
    "evidence"
  ],
  "title": "FloatSnapshot",
  "type": "object",
  "x-contract-version": "0.1.0"
}
