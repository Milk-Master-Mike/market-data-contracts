            "minLength": 1,
            "type": "string"
          },
          "title": "Event Tags",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "filed_date": {
          "format": "date",
          "title": "Filed Date",
          "type": "string"
        },
        "filing_id": {
          "minLength": 1,
          "title": "Filing Id",
          "type": "string"
        },
        "form": {
          "minLength": 1,
          "title": "Form",
          "type": "string"
        },
        "kind": {
          "const": "filing_event",
          "default": "filing_event",
          "title": "Kind",
          "type": "string"
        },
        "primary_document_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Primary Document Url",
          "type": "string"
        },
        "report_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Date"
        }
      },
      "required": [
        "filing_id",
        "company_id",
        "accession_number",
        "form",
        "filed_date",
        "primary_document_url",
        "evidence"
      ],
      "title": "FilingEvent",
      "type": "object"
    },
    "FloatMeasure": {
      "enum": [
        "issuer_reported_public_float",
        "shares_outstanding",
        "tradable_free_float",
        "other"
      ],
      "title": "FloatMeasure",
      "type": "string"
    },
    "FloatSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "company_id": {
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "instrument_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "kind": {
          "const": "float_snapshot",
          "default": "float_snapshot",
          "title": "Kind",
          "type": "string"
        },
        "measure": {
          "$ref": "#/$defs/FloatMeasure"
        },
        "methodology": {
          "minLength": 1,
          "title": "Methodology",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "snapshot_id",
        "company_id",
        "measure",
        "value",
        "as_of_date",
        "methodology",
        "evidence"
      ],
      "title": "FloatSnapshot",
      "type": "object"
    },
    "HorizonAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "calculation_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Calculation Version",
          "type": "string"
        },
        "calendar_months": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar Months"
        },
        "calendar_years": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar Years"
        },
        "company_id": {
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "conflicts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "evidence_strength_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Evidence Strength Score"
        },
        "explanation": {
          "description": "Explains research evidence, never a buy/sell instruction or return forecast.",
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "freshness_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Freshness Score"
        },
        "horizon_label": {
          "minLength": 1,
          "title": "Horizon Label",
          "type": "string"
        },
        "kind": {
          "const": "horizon_assessment",
          "default": "horizon_assessment",
          "title": "Kind",
          "type": "string"
        },
        "missing_inputs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "research_relevance_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Research Relevance Score"
        },
        "trading_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trading Days"
        }
      },
      "required": [
        "assessment_id",
        "company_id",
        "horizon_label",
        "research_relevance_score",
        "evidence_strength_score",
        "freshness_score",
        "components",
        "calculation_version",
        "explanation",
        "evidence"
      ],
      "title": "HorizonAssessment",
      "type": "object"
    },
