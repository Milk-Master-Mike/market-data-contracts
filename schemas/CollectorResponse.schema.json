{
  "$defs": {
    "CatalystCategory": {
      "enum": [
        "filing",
        "earnings",
        "guidance",
        "capital",
        "governance",
        "product",
        "regulatory",
        "macro",
        "other"
      ],
      "title": "CatalystCategory",
      "type": "string"
    },
    "Company": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "cik": {
          "anyOf": [
            {
              "pattern": "^\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cik"
        },
        "company_id": {
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "kind": {
          "const": "company",
          "default": "company",
          "title": "Kind",
          "type": "string"
        },
        "legal_name": {
          "minLength": 1,
          "title": "Legal Name",
          "type": "string"
        },
        "lei": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9]{20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lei"
        }
      },
      "required": [
        "company_id",
        "legal_name",
        "evidence"
      ],
      "title": "Company",
      "type": "object"
    },
    "CorrectionStatus": {
      "enum": [
        "original",
        "corrected",
        "superseded",
        "unknown"
      ],
      "title": "CorrectionStatus",
      "type": "string"
    },
    "EvidenceConflict": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect": {
          "minLength": 1,
          "title": "Effect",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "description",
        "evidence_ids",
        "effect"
      ],
      "title": "EvidenceConflict",
      "type": "object"
    },
    "FailureCode": {
      "enum": [
        "unavailable",
        "timeout",
        "rate_limited",
        "blocked",
        "malformed",
        "not_found",
        "stale",
        "cancelled",
        "internal"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "FilingEvent": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted At"
        },
        "accession_number": {
          "pattern": "^\\d{10}-\\d{2}-\\d{6}$",
